# Salin ke .env.local. Jangan commit .env.local.
# Lokal: nilai dari `pnpm exec supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Hanya server. Pengganti service_role key; jangan pernah diberi prefix NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Kunci tes Cloudflare (selalu lolos, invisible). Ganti dengan kunci asli di produksi.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000BB
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Rekening & QRIS WeddingLink yang tampil di halaman pembayaran (PRD bagian 5).
PAYMENT_BANK=BCA
PAYMENT_ACCOUNT_NO=
PAYMENT_ACCOUNT_NAME=
# URL gambar QRIS statis (opsional), mis. /qris.png di folder public/.
PAYMENT_QRIS_URL=
# Rahasia acak untuk Vercel Cron /api/cron/expire (openssl rand -hex 32).
CRON_SECRET=
